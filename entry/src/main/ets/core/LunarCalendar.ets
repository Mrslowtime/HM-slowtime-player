const TABLE: Map<number, string> = new Map<number, string>();

function fillTable(): void {
  if (TABLE.size > 0) {
    return;
  }
  const items: string[] = LUNAR_923_TABLE.split(',');
  for (const item of items) {
    const pair: string[] = item.split(':');
    if (pair.length === 2) {
      TABLE.set(Number(pair[0]), pair[1]);
    }
  }
}

function pad2(n: number): string {
  return n < 10 ? ('0' + n.toString()) : n.toString();
}

/**
 * 今天是农历九月二十三则返回当天标识（公历年份），否则返回空串。
 * 用年份当标识：同一年重复打开不会重复弹窗。
 */
export function lunar923Today(): string {
  fillTable();
  const now: Date = new Date();
  const year: number = now.getFullYear();
  const expected: string | undefined = TABLE.get(year);
  if (expected === undefined) {
    return '';
  }
  const today: string = pad2(now.getMonth() + 1) + '-' + pad2(now.getDate());
  return today === expected ? year.toString() : '';
}

/**
 * 全局手势时长统一配置。
 *
 * 系统 LongPressGesture 默认 500ms，歌曲行的 onTouch 判定原为 450ms，
 * 用户反馈「长按拖动识别时间有点长」，这里统一缩短到 260ms：
 * 明显长于普通点击（一般 < 150ms），所以仍能与点击区分；
 * 又比默认值快近一半，长按高亮/拖动不再有等待感。
 *
 * 软件内所有长按（列表 chip、列表抽屉选择与拖动、播放页封面、歌曲行）
 * 都必须引用本常量，后续要调只需改这一处。
 */
export const LONG_PRESS_DURATION_MS: number = 260;
